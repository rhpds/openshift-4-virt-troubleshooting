apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: vm6
  namespace: "{{ bootstrap_tenant_username }}-troubleshoot-03"
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: vm6
    spec:
      domain:
        devices:
          disks:
            - disk:
                bus: virtio
              name: containerdisk
            - disk:
                bus: virtio
              name: cloudinitdisk
          interfaces:
            - name: default
              masquerade: {}
            - name: secondary-net
              bridge: {}
        resources:
          requests:
            memory: 1024Mi
      networks:
        - name: default
          pod: {}
        - name: secondary-net
          multus:
            networkName: healthy-flat-net # (Using the correct, healthy NAD)
      volumes:
        - name: containerdisk
          containerDisk:
            # Using the standard RHEL 9 Guest Image
            image: registry.redhat.io/rhel9/rhel-guest-image
        - name: cloudinitdisk
          cloudInitNoCloud:
            userData: |
              #cloud-config
              user: cloud-user
              password: password123
              chpasswd: { expire: False }
              runcmd:
                - [ systemctl, stop, qemu-guest-agent ]
                - [ systemctl, disable, qemu-guest-agent ]
            networkData: |
              version: 2
              ethernets:
                eth1:
                  addresses:
                    - 10.10.10.51/24
