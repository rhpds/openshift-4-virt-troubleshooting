apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: vm4
  namespace: "{{ bootstrap_tenant_username }}-troubleshoot-02"
  labels:
    app.kubernetes.io/part-of: virt-troubleshooting
spec:
  runStrategy: Always
  template:
    metadata:
      labels:
        app: vm4-app
    spec:
      domain:
        cpu:
          cores: 1
        devices:
          disks:
            - disk:
                bus: virtio
              name: containerdisk
            - disk:
                bus: virtio
              name: cloudinitdisk
          interfaces:
            - masquerade: {}
              name: default
        resources:
          requests:
            memory: 1Gi
      networks:
        - name: default
          pod: {}
      volumes:
        - containerDisk:
            image: quay.io/containerdisks/fedora:40
          name: containerdisk
        - cloudInitNoCloud:
            userData: |
              #cloud-config
              user: cloud-user
              password: password123
              chpasswd: { expire: False }
              runcmd:
                - sed -i 's/gpgcheck=1/gpgcheck=0/g' /etc/yum.repos.d/*.repo
                - dnf install -y --nogpgcheck httpd
                - sed -i 's/^Listen 80/Listen 8080/' /etc/httpd/conf/httpd.conf
                - echo "Hello from vm4 web service!" > /var/www/html/index.html
                - systemctl enable --now httpd
          name: cloudinitdisk
