apiVersion: kubevirt.io/v1
kind: VirtualMachine
metadata:
  name: vm7
  namespace: "{{ bootstrap_tenant_username }}-troubleshoot-04"
spec:
  running: true
  template:
    metadata:
      labels:
        kubevirt.io/vm: vm7
    spec:
      affinity:
        podAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            - labelSelector:
                matchLabels:
                  app: anchor
              topologyKey: kubernetes.io/hostname
      domain:
        devices:
          disks:
            - disk:
                bus: virtio
              name: containerdisk
          interfaces:
            - name: default
              masquerade: {}
        resources:
          requests:
            memory: 1024Mi
      networks:
        - name: default
          pod: {}
      volumes:
        - name: containerdisk
          containerDisk:
            image: registry.redhat.io/rhel9/rhel-guest-image
